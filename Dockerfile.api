# API版本构建阶段
FROM ubuntu:22.04 AS api-builder

# 避免交互式提示
ENV DEBIAN_FRONTEND=noninteractive

# 安装系统依赖
RUN apt-get update && apt-get install -y \
    curl \
    build-essential \
    pkg-config \
    libssl-dev \
    git \
    unzip \
    xz-utils \
    && rm -rf /var/lib/apt/lists/*

# 安装Rust
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"

# 安装Flutter (用于代码生成)
RUN git clone https://github.com/flutter/flutter.git -b stable --depth 1 /flutter
ENV PATH="/flutter/bin:/flutter/bin/cache/dart-sdk/bin:${PATH}"

# 设置工作目录
WORKDIR /app

# 只复制Rust相关文件
COPY rust/ ./rust/
COPY flutter_rust_bridge.yaml ./

# 生成桥接代码
RUN flutter pub get && flutter_rust_bridge_codegen generate

# 构建Rust二进制文件
RUN cd rust && cargo build --release --bin m3u8_api_server

# API运行时阶段
FROM ubuntu:22.04

# 避免交互式提示
ENV DEBIAN_FRONTEND=noninteractive

# 安装运行时依赖
RUN apt-get update && apt-get install -y \
    ffmpeg \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# 创建应用用户
RUN useradd -m -s /bin/bash appuser

# 创建应用目录
RUN mkdir -p /app && chown -R appuser:appuser /app

# 切换到应用用户
USER appuser

# 设置工作目录
WORKDIR /app

# 从构建阶段复制二进制文件
COPY --from=api-builder /app/rust/target/release/m3u8_api_server ./

# 创建下载目录
RUN mkdir -p downloads

# 设置环境变量
ENV FFMPEG_PATH=/usr/bin/ffmpeg
ENV DOWNLOAD_DIR=/app/downloads
ENV RUST_LOG=info

# 暴露API端口
EXPOSE 3000

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:3000/health || exit 1

# 启动API服务器
CMD ["./m3u8_api_server"]
